<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_journal_form" model="ir.ui.view">
        <field name="name">account.journal.form</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='inbound_payment_method_line_ids']/list/field[@name='payment_account_id']" position="after">
                <field name="mp_point_store_id" string="Store ID" invisible="code != 'mercadopago_point'"/>
                <field name="mp_point_pos_id" string="POS ID" invisible="code != 'mercadopago_point'"/>
            </xpath>
        </field>
    </record>
</odoo>
