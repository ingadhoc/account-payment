<?xml version="1.0" encoding="utf-8"?>
<odoo>

        <record id="view_account_payment_form_mp_point" model="ir.ui.view">
            <field name="name">account.payment.form.mp.point</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <field name="payment_method_line_id" position="after">
                    <field name="mp_point_order_id"
                           invisible="payment_method_code != 'mercadopago_point'"/>
                    <field name="mp_point_order_status"
                           invisible="payment_method_code != 'mercadopago_point'"/>
                </field>
            </field>
        </record>

</odoo>
