<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.mercadopago_point</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='default_accounts']" position="inside">
                <block title="MercadoPago Point Settings" id="mercadopago_point_settings">
                    <setting string="MercadoPago Point Access Token" company_dependent="1"
                            help="MercadoPago Point Access Token for API authentication.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="mp_point_access_token" class="col-lg-5 o_light_label"/>
                                <field name="mp_point_access_token" password="True"/>
                            </div>
                        </div>
                    </setting>

                    <setting string="MercadoPago Point Client ID" company_dependent="1"
                            help="MercadoPago Point Client ID for API authentication.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="mp_point_client_id" class="col-lg-5 o_light_label"/>
                                <field name="mp_point_client_id"/>
                            </div>
                        </div>
                    </setting>

                    <setting string="MercadoPago Point Client Secret" company_dependent="1"
                            help="MercadoPago Point Client Secret for API authentication.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="mp_point_client_secret" class="col-lg-5 o_light_label"/>
                                <field name="mp_point_client_secret" password="True"/>
                            </div>
                        </div>
                    </setting>

                    <setting string="Sandbox Mode" company_dependent="1"
                            help="Enable sandbox mode for MercadoPago Point testing.">
                        <div class="content-group">
                            <div class="row mt8">
                                <label for="mp_point_sandbox_mode" class="col-lg-5 o_light_label"/>
                                <field name="mp_point_sandbox_mode"/>
                            </div>
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
