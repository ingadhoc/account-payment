<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="account_check_reject_wizard_form_view">
        <field name="name">account.check.reject.wizard.form</field>
        <field name="model">account.check.reject.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Check">
                <group>
                    <field name="company_id" invisible="1"/>
                    <field name="date"/>
                    <field name="rejected_journal_id"/>
                </group>
                <group>
                    <field name="case_description" invisible="not case_description" readonly="1" string="Action Summary"/>
                </group>
                <footer>
                    <button string="Confirm" name="action_confirm" type="object" class="oe_highlight"/>
                    or
                    <button string="Cancel" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_reject_check_wizard" model="ir.actions.act_window">
        <field name="name">Reject Check</field>
        <field name="res_model">account.check.reject.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
