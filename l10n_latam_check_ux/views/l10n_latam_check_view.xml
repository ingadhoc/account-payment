<odoo>
    <!-- Heredamos la vista de l10n_latam_check l10n_latam_check_view_form para agregar el botón para debitar cheques propios. -->
    <record id="l10n_latam_check_view_form" model="ir.ui.view">
        <field name="name">l10n_latam.check.form.inherited</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.l10n_latam_check_view_form" />
        <field name="arch" type="xml">
            <form  position="attributes">
                <attribute name="edit">True</attribute>
            </form>
            <field name="amount" position="attributes">
                <attribute name="readonly">True</attribute>
            </field>
            <field name="name" position="attributes">
                <attribute name="readonly">not user_can_write</attribute>
            </field>
            <field name="issuer_vat" position="attributes">
                <attribute name="readonly">not user_can_write</attribute>
            </field>
            <field name="payment_date" position="attributes">
                <attribute name="readonly">not user_can_write</attribute>
            </field>
            <!-- The bank of the check comes first; the bank account is computed from it and can still be changed among the accounts of that bank -->
            <field name="current_journal_id" position="after">
                <field name="check_state" invisible="issue_state"/>
            </field>
            <field name="bank_account_id" position="before">
                <field name="bank_id" invisible="issue_state" readonly="not user_can_write"/>
            </field>
            <field name="bank_account_id" position="attributes">
                <attribute name="readonly">not user_can_write</attribute>
                <attribute name="domain">[('bank_id', '=', bank_id)] if bank_id else []</attribute>
            </field>
            <xpath expr="//button[@name='action_void']" position="after">
                <field name="check_add_debit_button" invisible="1"/>
                <field name="can_reject" invisible="1"/>
                <button name="%(action_debit_check_wizard)d"
                        string="Debit check"
                        invisible="payment_method_code != 'own_checks' or issue_state != 'handed' or not check_add_debit_button"
                        type="action"/>
                <button name="%(action_reject_check_wizard)d"
                        string="Reject Check"
                        invisible="not can_reject"
                        type="action"
                        class="oe_highlight"/>
            </xpath>
            <!-- Con una línea de liquidez por cheque el asiento ya no es 1:1 con outstanding_line_id
                 (task 70884): el botón deja de tener sentido, igual que lo saca el parche de core
                 que este módulo reemplaza (odoo/odoo#248741). -->
            <xpath expr="//button[@name='action_show_journal_entry']" position="replace"/>
            <field name="outstanding_line_id" position="replace"/>
        </field>
    </record>

    <record model="ir.ui.view" id="view_account_own_check_tree">
        <field name="name">account.check.list</field>
        <field name="model">l10n_latam.check</field>
        <field name="priority" eval="109"/>
        <field name="inherit_id" ref="l10n_latam_check.view_account_own_check_tree" />
        <field name="arch" type="xml">
            <list position="inside">
                <header>
                    <button name="action_check_debit" type="object" string="Debit"/>
                    <button name="action_check_void" type="object" string="Void"
                            confirm="Voiding a check cancels it and generates a new entry that re-opens the debt."/>
                </header>
            </list>
            <xpath expr="//field[@name='payment_date']" position="before">
                <field name="date" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='issue_state']" position="after">
                <field name="memo" optional="hide"/>
            </xpath>
            <xpath expr="//field[@name='amount']" position="attributes">
                <attribute name="sum">Total</attribute>
            </xpath>
        </field>
    </record>

    <record id="view_account_third_party_check_operations_tree" model="ir.ui.view">
        <field name="name">account.check.operations.list.inherit</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_third_party_check_operations_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="l10n_latam_move_check_ids_operation_date" optional="show"/>
            </field>
            <!-- La cadena de operaciones del cheque se ordena por su fecha de operacion, no por la
                 fecha contable: dos operaciones del mismo dia caian en el desempate por id y la
                 lista quedaba al reves del orden real. El desempate por id acompana al de
                 _get_last_operation(), asi la primera fila es siempre la ultima operacion. -->
            <list position="attributes">
                <attribute name="default_order">l10n_latam_move_check_ids_operation_date desc, id desc</attribute>
            </list>
        </field>
    </record>

    <record model="ir.ui.view" id="view_account_payment_search">
        <field name="name">account.check.search.inherit</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='payment_date']" position="after">
                <filter string="Last 90 days" name="last_90_days" domain="[('payment_date', '&gt;=', (context_today() - relativedelta(days=90)).strftime('%Y-%m-%d'))]" />
                <separator/>
                <filter string="Due This Week" name="due_week" domain="[('payment_date', '&gt;=', context_today().strftime('%Y-%m-%d')), ('payment_date', '&lt;=', (context_today() + relativedelta(days=7)).strftime('%Y-%m-%d'))]"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_third_party_checks_search" model="ir.ui.view">
        <field name="name">l10n_latam.check.third_party.search.inherit</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_payment_third_party_checks_search"/>
        <field name="arch" type="xml">
            <field name="bank_account_id" position="replace">
                <field name="bank_id"/>
            </field>
            <filter name="checks_on_hand" position="before">
                <filter string="In Portfolio" name="check_state_on_hand" domain="[('check_state', '=', 'on_hand')]"/>
                <filter string="Deposited" name="check_state_deposited" domain="[('check_state', '=', 'deposited')]"/>
                <filter string="Endorsed" name="check_state_endorsed" domain="[('check_state', '=', 'endorsed')]"/>
                <filter string="Rejected" name="check_state_rejected" domain="[('check_state', '=', 'rejected')]"/>
                <filter string="Returned" name="check_state_returned" domain="[('check_state', '=', 'returned')]"/>
                <separator/>
            </filter>
            <filter name="groupby_current_journal" position="after">
                <filter name="groupby_check_state" string="State" context="{'group_by': 'check_state'}"/>
            </filter>
        </field>
    </record>

    <record model="ir.ui.view" id="view_account_third_party_check_tree_reject">
        <field name="name">account.third.party.check.list.reject</field>
        <field name="model">l10n_latam.check</field>
        <field name="inherit_id" ref="l10n_latam_check.view_account_third_party_check_tree"/>
        <field name="arch" type="xml">
            <!-- Each action checks the state of the selected checks before opening its wizard (task 80427).
                 Deposit and Transfer reuse the core transfer wizard, narrowing the destination journals. -->
            <xpath expr="//list/header/button[@name='%(l10n_latam_check.action_view_l10n_latam_payment_mass_transfer)d']" position="replace">
                <button name="action_check_deposit" type="object" string="Deposit"/>
                <button name="action_check_transfer" type="object" string="Transfer"/>
                <button name="action_check_endorse" type="object" string="Endorse"/>
                <button name="action_check_return" type="object" string="Return to Customer"/>
                <button name="action_check_reject" type="object" string="Reject"/>
            </xpath>
            <field name="current_journal_id" position="after">
                <field name="check_state" widget="badge"
                       decoration-info="check_state == 'on_hand'"
                       decoration-success="check_state == 'deposited'"
                       decoration-warning="check_state == 'endorsed'"
                       decoration-danger="check_state == 'rejected'"
                       decoration-muted="check_state == 'returned'"/>
            </field>
        </field>
    </record>
</odoo>
