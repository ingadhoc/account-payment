msgid "The amount doesn't follow the debt. Click to unlock it."
msgstr "El importe no acompaña a la deuda. Haga clic para desbloquearlo."

#. module: account_payment_pro_htl
#: model_terms:ir.ui.view,arch_db:account_payment_pro_htl.view_account_payment_form
msgid "The amount follows the debt. Click to lock it."
msgstr "El importe acompaña a la deuda. Haga clic para bloquearlo."

#. module: account_payment_pro_htl
#: model:ir.model.fields,help:account_payment_pro_htl.field_account_payment__amount_locked
msgid ""
"When locked, changing the debt of a new payment keeps the amount loaded by "
"the user. Unlock it to let the amount follow the selected debt."
msgstr ""
"Si está bloqueado, al cambiar la deuda de un pago nuevo se mantiene el "
"importe cargado por el usuario. Desbloquéelo para que el importe acompañe a "
"la deuda seleccionada."
