#. module: account_payment_early_discount
#: model_terms:ir.ui.view,arch_db:account_payment_early_discount.view_account_payment_form
msgid ""
"<span>. The payment was cancelled or one of its checks was returned to the "
"customer: if the discount does not apply anymore, create the debit note by "
"hand.</span>"
msgstr ""
"<span>. El pago se canceló o uno de sus cheques se devolvió al cliente: si el "
"descuento ya no corresponde, cree la nota de débito manualmente.</span>"

