<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.early.discount</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account_payment_pro.view_account_payment_form"/>
        <field name="arch" type="xml">
            <sheet position="before">
                <div class="alert alert-warning mb-2" role="alert" invisible="not early_discount_warning_credit_note_ids">
                    <span>The early payment discount credit notes created by this payment are still posted: </span>
                    <field name="early_discount_warning_credit_note_ids" widget="x2many_buttons"/>
                    <span>. The payment was cancelled or one of its checks was returned to the customer: if the discount does not apply anymore, create the debit note by hand.</span>
                </div>
            </sheet>
            <div name="payment_total" position="after">
                <field name="early_discount_suggested_amount" invisible="1"/>
                <field name="early_discount_available" invisible="1"/>
                <field name="early_discount_apply" invisible="1"/>
                <label for="early_discount_amount" invisible="state != 'draft' or not early_discount_available"/>
                <div name="early_discount_amount" invisible="state != 'draft' or not early_discount_available">
                    <field name="early_discount_amount" class="oe_inline"/>
                    <button name="action_early_discount_exclude" type="object"
                        class="btn btn-link btn-sm p-0 ms-1" title="Do not apply the discount on this payment"
                        invisible="not early_discount_apply">
                        <i class="fa fa-arrow-left"/> Exclude
                    </button>
                    <button name="action_early_discount_recalculate" type="object"
                        class="btn btn-link btn-sm p-0 ms-1" title="Apply the discount again on this payment"
                        invisible="early_discount_apply">
                        <i class="fa fa-arrow-left"/> Recalculate
                    </button>
                </div>
            </div>
            <!-- own list of the debt, so the early discount columns follow the payment date; the add line dialog keeps
                 using the list of Payment Pro, which has no parent payment -->
            <field name="to_pay_move_line_ids" position="inside">
                <list string="Journal Items" edit="0" create="0" editable="bottom">
                    <field name="date" readonly="True"/>
                    <field name="date_maturity" optional="hide" readonly="True"/>
                    <field name="move_name" string="Journal Entry" widget="open_move_widget" readonly="True"/>
                    <field name="journal_id" options='{"no_open":True}' readonly="True" optional="hide"/>
                    <field name="name" readonly="True" optional="hide"/>
                    <field name="ref" optional="show" readonly="True"/>
                    <field name="statement_id" column_invisible="True" readonly="True"/>
                    <field name="account_id" options='{"no_open":True}' domain="[('company_ids', '=', company_id)]" readonly="True" optional="hide"/>
                    <field name="amount_residual_currency" readonly="True" string="Residual"/>
                    <field name="early_discount_available" column_invisible="True"/>
                    <field name="discount_date" string="Discount Until" optional="show" readonly="True" invisible="not early_discount_available or discount_date &lt; parent.date"/>
                    <field name="early_discount_amount_to_pay" optional="show" invisible="not early_discount_available or discount_date &lt; parent.date"/>
                    <field name="amount_residual" optional="hide" readonly="True" string="Residual CC" help="Residual amount in company currency"/>
                    <field name="amount_currency" readonly="True" string="Amount" help="Total debt"/>
                    <field name="balance" optional="hide" string="Amount CC" help="Total debt amount in company currency" readonly="True"/>
                    <field name="currency_id" column_invisible="True" readonly="True"/>
                    <field name="company_currency_id" column_invisible="True" readonly="True"/>
                    <field name="company_id" column_invisible="True" readonly="True"/>
                </list>
            </field>
            <!-- with the discount applied, the payment difference shown and adjusted is the one after the discount -->
            <xpath expr="//div[@name='payment_total']//field[@name='payment_difference']" position="attributes">
                <attribute name="invisible">early_discount_amount</attribute>
            </xpath>
            <xpath expr="//div[@name='payment_total']//field[@name='payment_difference']" position="after">
                <field name="early_discount_difference" class="oe_inline" invisible="not early_discount_amount"/>
            </xpath>
            <xpath expr="//div[@name='payment_total']//button[@name='action_adjust_amount_for_difference']" position="attributes">
                <attribute name="invisible" add="(early_discount_amount and not early_discount_difference)" separator=" or "/>
            </xpath>
            <xpath expr="//div[@name='payment_total']//button[@name='action_adjust_writeoff_for_difference']" position="attributes">
                <attribute name="invisible" add="(early_discount_amount and not early_discount_difference)" separator=" or "/>
            </xpath>
        </field>
    </record>

    <record id="view_move_line_tree" model="ir.ui.view">
        <field name="name">account.move.line.list.early.discount</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account_payment_pro.view_move_line_tree"/>
        <field name="arch" type="xml">
            <field name="amount_residual_currency" position="after">
                <field name="early_discount_available" column_invisible="True"/>
                <field name="discount_date" string="Discount Until" optional="show" readonly="True" invisible="not early_discount_available or discount_date &lt; context_today().strftime('%Y-%m-%d')"/>
                <field name="early_discount_amount_to_pay" optional="show" invisible="not early_discount_available or discount_date &lt; context_today().strftime('%Y-%m-%d')"/>
            </field>
        </field>
    </record>

    <record id="view_move_line_with_matched_tree" model="ir.ui.view">
        <field name="name">account.move.line.list.matched.early.discount</field>
        <field name="model">account.move.line</field>
        <field name="inherit_id" ref="account_payment_pro.view_move_line_with_matched_tree"/>
        <field name="arch" type="xml">
            <field name="discount_date" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </field>
            <field name="early_discount_amount_to_pay" position="attributes">
                <attribute name="column_invisible">True</attribute>
            </field>
        </field>
    </record>

</odoo>
