<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_account_payment_form" model="ir.ui.view">
        <field name="name">account.payment.form.bundle.early.discount</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account_payment_early_discount.view_account_payment_form"/>
        <field name="arch" type="xml">
            <!-- on the main payment the discount shown is the one of the invoices the linked payments already pay; the
                 label and the buttons stay, so the discount can be excluded from the start -->
            <xpath expr="//label[@for='early_discount_amount']" position="attributes">
                <attribute name="for">bundle_early_discount_applied</attribute>
                <attribute name="string">Early Payment Discount</attribute>
            </xpath>
            <xpath expr="//div[@name='early_discount_amount']/field[@name='early_discount_amount']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//div[@name='early_discount_amount']/field[@name='early_discount_amount']" position="after">
                <field name="is_main_payment" invisible="1"/>
                <field name="bundle_early_discount_applied" class="oe_inline"
                    invisible="is_main_payment and not bundle_early_discount_applied"/>
            </xpath>
        </field>
    </record>

</odoo>
