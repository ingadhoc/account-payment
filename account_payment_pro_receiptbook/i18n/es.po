msgid "You can only resequence items from the same journal"
msgstr "Solo puede resecuenciar ítems del mismo diario"

#. module: account_payment_pro_receiptbook
#. odoo-python
#: code:addons/account_payment_pro_receiptbook/__init__.py:0
msgid "You can only resequence items from the same receiptbook"
msgstr "Solo se pueden resecuenciar ítems del mismo talonario de recibos"

#. module: account_payment_pro_receiptbook
#. odoo-python
#: code:addons/account_payment_pro_receiptbook/__init__.py:0
msgid ""
"You can only resequence items if all selected moves belong to the same "
"receiptbook, or if none have a receiptbook assigned."
msgstr ""
"Solo puede resecuenciar ítems si todos los movimientos seleccionados "
"pertenecen al mismo talonario de recibos o si ninguno tiene un talonario de "
"recibos asignado."

#. module: account_payment_pro_receiptbook
#. odoo-python
#: code:addons/account_payment_pro_receiptbook/models/account_payment_receiptbook.py:0
msgid "You can't delete receiptbook used in publish payments."
msgstr ""
"No puede eliminar el talonario de recibos ya que se encuentra utilizado en "
"pagos publicados."
